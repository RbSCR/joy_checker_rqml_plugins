<?xml version='1.0' encoding='UTF-8'?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>joy_checker_rqml_plugins</name>
  <version>0.9.0</version>
  <!-- TODO update version number-->
  <description>A set of RQML plugins to visualy check 'Joy' and 'JoyFeedback' messages     and (visually) publish 'JoyFeedback' messages for testing purposes.</description>
  <maintainer email="6249544+RbSCR@users.noreply.github.com">RbSCR</maintainer>
  <license>GPL-3.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rqml_core</depend>

  <exec_depend>qml6-module-qtquick-controls</exec_depend>
  <exec_depend>qml6-module-qtquick-layouts</exec_depend>
  <exec_depend>qml6_ros2_plugin</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
